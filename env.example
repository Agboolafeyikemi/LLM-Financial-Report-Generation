# Environment Variables Configuration
# Copy this file to .env and update values as needed

# LLM Provider Selection
# Options: openai, anthropic, ollama, demo
# Default: ollama (local)
# LLM_PROVIDER=ollama

# ============================================
# OpenAI Configuration (if LLM_PROVIDER=openai)
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# Anthropic Configuration (if LLM_PROVIDER=anthropic)
# ============================================
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ============================================
# Ollama Configuration (if LLM_PROVIDER=ollama)
# ============================================
# Ollama Base URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Ollama Timeout (seconds) - Increase for CPU-only environments like Codespaces
# Default: 300 (5 minutes) for CPU inference
# OLLAMA_TIMEOUT=300

# ============================================
# Demo Mode (if LLM_PROVIDER=demo or DEMO_MODE=true)
# ============================================
# Set to "true" to use pre-generated responses instead of real LLM
# Useful for testing without API keys or Ollama
# DEMO_MODE=false

# ============================================
# General Configuration
# ============================================
# Default LLM Model (provider-specific)
# Ollama: phi4:latest, gemma3:12b, deepseek-r1:1.5b
# OpenAI: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
# Anthropic: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# DEFAULT_MODEL=phi4:latest

# Default Temperature (0.0 to 1.0)
# DEFAULT_TEMPERATURE=0.1

# Default Max Tokens
# DEFAULT_MAX_TOKENS=2048

# Output Directory
# DEFAULT_OUTPUT_DIR=./output

# Streamlit Configuration (if needed)
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
